[Unit]
Description=Feishu Group Summary Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/feishu-group-summary
Environment=PYTHONPATH=/home/ubuntu/apps/feishu-group-summary/src
EnvironmentFile=/etc/feishu-group-summary.env
EnvironmentFile=-/home/ubuntu/info-radar/config/local.env
Environment=SUMMARY_SEND_ENABLED=true
Environment=HOMEWORK_REACTION_ENABLED=true
Environment=SUMMARY_SCHEDULE_ENABLED=true
Environment=SUMMARY_HOUR=23
Environment=SUMMARY_MINUTE=0
Environment="SUMMARY_COMMANDS=打开日报,#总结,#今日总结"
Environment='GROUP_DATABASES_JSON={"oc_group_1":"./data/group_1.sqlite3"}'
Environment=GROUP_PROFILES_PATH=./config/group_profiles.json
Environment=CAPTURE_ONLY_CHAT_IDS=
Environment=REMINDER_ENABLED=true
Environment=REMINDER_HOUR=12
Environment=REMINDER_MINUTE=0
Environment=MISSING_LIST_ENABLED=true
Environment=MISSING_LIST_HOUR=17
Environment=MISSING_LIST_MINUTE=0
Environment=FINAL_STATUS_ENABLED=true
Environment=FINAL_STATUS_HOUR=20
Environment=FINAL_STATUS_MINUTE=0
Environment=MAKEUP_REMINDER_ENABLED=true
Environment=MAKEUP_REMINDER_HOUR=11
Environment=MAKEUP_REMINDER_MINUTE=0
Environment=MAKEUP_DEADLINE_HOUR=12
Environment=MAKEUP_DEADLINE_MINUTE=0
Environment=MAKEUP_SUMMARY_ENABLED=true
Environment=MAKEUP_SUMMARY_HOUR=12
Environment=MAKEUP_SUMMARY_MINUTE=0
Environment='COURSE_PHASES_JSON=[{"name":"技术周","start_date":"2026-08-17","end_date":"2026-08-26","cycle_days":2,"publish_hour":10,"publish_minute":0,"due_hour":20,"due_minute":0},{"name":"视频周","start_date":"2026-08-28","end_date":"","cycle_days":1,"publish_hour":8,"publish_minute":0,"due_hour":20,"due_minute":0}]'
Environment=ASSIGNMENT_CYCLE_START_DATE=2026-08-17
Environment=COURSE_END_DATE=2026-08-26
Environment=ASSIGNMENT_CYCLE_DAYS=2
Environment=ASSIGNMENT_PUBLISH_HOUR=10
Environment=ASSIGNMENT_PUBLISH_MINUTE=0
Environment=ASSIGNMENT_DUE_HOUR=20
Environment=ASSIGNMENT_DUE_MINUTE=0
Environment='ASSIGNMENT_DEADLINE_OVERRIDES_JSON={}'
Environment=BASE_SYNC_ENABLED=false
ExecStart=/home/ubuntu/apps/feishu-group-summary/.venv/bin/feishu-group-summary run
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
