# 飞书自建应用凭证（不要提交真实 Secret）
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=

# MiniMax 国内 OpenAI 兼容接口
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_API_KEY=
LLM_MODEL=MiniMax-M3

# 目标群 ID，多个用逗号分隔；留空表示接受机器人所在的任意群
FEISHU_CHAT_IDS=

# 多群拆库：每个 chat_id 对应一个独立 SQLite；配置后只接收映射中的群
GROUP_DATABASES_JSON=
# 可选：每个群自己的名单、昵称、Base 和发送开关；相对路径按服务工作目录解析
GROUP_PROFILES_PATH=./config/group_profiles.json
# 也可直接传 JSON；设置后优先于 GROUP_PROFILES_PATH
GROUP_PROFILES_JSON=
# 尚未配置独立名单/多维表格的群可先只收集，不回复、不催交、不发日报
CAPTURE_ONLY_CHAT_IDS=

# 每天上海时间 23:00 自动总结当天；群里发“打开日报”可随时触发当天总结
SUMMARY_TIMEZONE=Asia/Shanghai
SUMMARY_HOUR=23
SUMMARY_MINUTE=0
SUMMARY_COMMANDS="打开日报,#总结,#今日总结"
# false 时只收集消息，不执行定时发送，也不回复群内日报指令
SUMMARY_SEND_ENABLED=true
SUMMARY_SCHEDULE_ENABLED=true
# 只有消息已被规则引擎确认为作业时，才随机回复一个飞书表情
HOMEWORK_REACTION_ENABLED=false
# @ 机器人时可进行群规则、课程/项目与普通低风险对话
SOCIAL_CHAT_ENABLED=false
# 未 @ 机器人时，允许它在明确求助或值得鼓励的消息下克制接话
SOCIAL_CHAT_PROACTIVE_ENABLED=false
SOCIAL_CHAT_COOLDOWN_MINUTES=8
SOCIAL_CHAT_HOURLY_LIMIT=4

# 当期作业截止日 12:00 自动 @ 仍未交的成员
REMINDER_ENABLED=true
REMINDER_HOUR=12
REMINDER_MINUTE=0

# 正常截止日 17:00 发未交名单；最终汇总由 22:00 补交汇总承担
MISSING_LIST_ENABLED=true
MISSING_LIST_HOUR=17
MISSING_LIST_MINUTE=0
FINAL_STATUS_ENABLED=false
FINAL_STATUS_HOUR=22
FINAL_STATUS_MINUTE=0

# 视频周在正常截止当日 22:00 结束补交并发最终汇总
# 17:00 已有未交名单，因此不再另发一条补交 @ 提醒
MAKEUP_REMINDER_ENABLED=false
MAKEUP_REMINDER_HOUR=17
MAKEUP_REMINDER_MINUTE=0
# 全局值作为旧阶段兼容配置；视频周的 22:00 由 COURSE_PHASES_JSON 覆盖
MAKEUP_DEADLINE_HOUR=12
MAKEUP_DEADLINE_MINUTE=0
MAKEUP_SUMMARY_ENABLED=true
MAKEUP_SUMMARY_HOUR=22
MAKEUP_SUMMARY_MINUTE=0

# 多课程阶段：作业序号在每个阶段内独立重置。end_date 留空表示持续运行。
# publish 是统计窗口的开始时间；机器人不会凭空生成并发布作业内容。
COURSE_PHASES_JSON=[{"name":"技术周","start_date":"2026-08-17","end_date":"2026-08-26","cycle_days":2,"publish_hour":10,"publish_minute":0,"due_hour":20,"due_minute":0},{"name":"视频周","start_date":"2026-08-28","end_date":"","cycle_days":1,"publish_hour":8,"publish_minute":0,"due_day_offset":1,"due_hour":12,"due_minute":0,"makeup_day_offset":0,"makeup_hour":22,"makeup_minute":0}]

# 旧版单阶段兼容配置；配置 COURSE_PHASES_JSON 后，以上方多阶段配置为准
ASSIGNMENT_CYCLE_START_DATE=2026-08-17
COURSE_END_DATE=2026-08-26
ASSIGNMENT_CYCLE_DAYS=2
ASSIGNMENT_PUBLISH_HOUR=10
ASSIGNMENT_PUBLISH_MINUTE=0
ASSIGNMENT_DUE_HOUR=20
ASSIGNMENT_DUE_MINUTE=0

# 单次作业延期（可选）：键为作业日期，值为上海时间截止点；不会改变其他作业的截止时间
# 例如：ASSIGNMENT_DEADLINE_OVERRIDES_JSON={"2026-08-17":"2026-08-18 14:00"}
ASSIGNMENT_DEADLINE_OVERRIDES_JSON=

MAX_MESSAGES=2000
MAX_CHARS_PER_REQUEST=50000
SUMMARY_DB_PATH=./data/group_messages.sqlite3
LOG_LEVEL=INFO

# 成员别名（可选）：JSON 对象，键为 open_id，值为昵称，会覆盖内置别名
# 例如：MEMBER_ALIASES_JSON={"ou_xxx":"新昵称"}
MEMBER_ALIASES_JSON=
# 可选：把群里的旧显示名统一成昵称，也可按群写在 group_profiles.json
VISIBLE_NAME_ALIASES_JSON=

# 排除成员（可选）：逗号分隔的 open_id 列表，会追加到内置排除名单
# 例如：EXCLUDED_MEMBER_IDS=ou_xxx,ou_yyy
EXCLUDED_MEMBER_IDS=

# 可代替他人修改作业状态的组长 open_id；多群时优先写入 group_profiles.json
LEADER_MEMBER_IDS=

# 日报版式与打卡规则
REPORT_TITLE=进阶营作业群・每日日报
# 默认已经内置当前 22 人名单；名单变化时可在这里用英文逗号分隔覆盖
REPORT_MEMBERS=
REPORT_LINK=
REVIEW_TAG=#复盘

# 机器人拥有的多维表格，避免高级权限导致只能读不能写
BASE_SYNC_ENABLED=false
BASE_TOKEN=
BASE_TABLE_ID=
